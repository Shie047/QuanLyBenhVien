public abstract class Person {
    protected String name;
    protected int age;
    protected int year;

    public Person(int age, String name, int year) {
        this.age = age;
        this.name = name;
        this.year = year;
    }

    public int getAge() {
        return age;
    }

    public void setAge(int age) {
        this.age = age;
    }

    public String getName() {
        return name;
    }

    public void setName(String name) {
        this.name = name;
    }

    public int getYear() {
        return year;
    }

    public void setYear(int year) {
        this.year = year;
    }
    public abstract void showInfo();
}
